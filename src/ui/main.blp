using Gtk 4.0;
using Adw 1;


menu main_menu {
    item (_("Rescan Games"), "app.rescan")
    item (_("Preferences"), "app.preferences")
}


Adw.ApplicationWindow main {
    
    default-width: 850;
    default-height: 550;
    width-request: 850;
    height-request: 600;
    content: Adw.NavigationSplitView {
        sidebar: Adw.NavigationPage {
            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    title-widget: Label {
                    label: _("Runners");
                    };
                }
                content: Adw.Sidebar sidebar {
                    Adw.SidebarSection sourceList {}
                };
            };
        };
        content: Adw.NavigationPage {
            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    title-widget: Label {
                        label: _("Games");
                    };
                [start]
                MenuButton {
                  icon-name: "open-menu-symbolic";
                  menu-model: main_menu;
                  primary: true;
                }
                }
                content: ScrolledWindow {                
                    FlowBox gamesList {
                        homogeneous: true;
                        min-children-per-line: 2;
                    }
                };
            };
        };
    };
}

