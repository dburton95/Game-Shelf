using Gtk 4.0;
using Adw 1;



Adw.ApplicationWindow main {
    
    default-width: 850;
    default-height: 550;
    width-request: 850;
    height-request: 600;
    content: Adw.NavigationSplitView {
        sidebar: Adw.NavigationPage {
            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    title-widget: Label {
                    label: _("Runners");
                    };
                }
                content: Adw.Sidebar sidebar {
                    Adw.SidebarSection sourceList {}
                };
            };
        };
        content: Adw.NavigationPage {
            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    title-widget: Label {
                        label: _("Games");
                    };
                }
                content: ScrolledWindow {                
                    FlowBox gamesList {
                        homogeneous: true;
                        min-children-per-line: 2;
                    }
                };
            };
        };
    };
}