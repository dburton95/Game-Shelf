using Gtk 4.0;
using Adw 1;

Adw.Window gameEdit {
  default-height: 500;
  default-width: 750;
  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar header {}
    content: Box {
      valign: start;
      orientation: horizontal;
      homogeneous: true;
      Picture gameCover {}
      Adw.Clamp{
        orientation: horizontal;
        maximum-size: 300;
        Box allSettings {
          orientation: vertical;
          Adw.PreferencesGroup {
            title: _("About");
            Adw.ActionRow currentTitle {
              title: _("Title");
            }
            Adw.ActionRow currentCommand {
              title: _("Launch Command");
            }
          }
          Box {
            orientation: horizontal;
            Adw.PreferencesGroup {
              title: _("Settings");
              Adw.SwitchRow hideSwitch {
                title: _("Hidden");
              }
              Adw.Clamp {
                orientation: vertical;
                maximum-size: 10;
                Box {
                  orientation: horizontal;
                  vexpand: false;
                  Button changeCover {
                    label: _("Change Cover");
                  }
                  Button searchSgdb {
                    label: _("Search SteamGDB");
                  }
                  Button resetCover {
                    icon-name: "view-refresh-symbolic";
                  }
                }
              }
            }
          }
        }
      }
    };
  };
}
